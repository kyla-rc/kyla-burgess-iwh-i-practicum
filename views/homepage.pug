doctype html
html 
    head 
        title= `${title}`
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body    
        h1 Pets Table
        a(href="/update-cobj") Add/Update this table
        table
            thead
                tr
                th Name
                th Animal
                th D.O.B.
            tbody
                each pet in data
                    tr
                        td #{pet.properties.name}
                        td #{pet.properties.pet_type}
                        td #{pet.properties.date_of_birth}